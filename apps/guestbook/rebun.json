{
  "name": "Guestbook",
  "description": "Mural de recados público.",
  "frameworks": ["next", "tanstack-start"],
  "env": ["REBUN_API_KEY"],
  "tables": [
    {
      "name": "messages",
      "columns": [
        { "name": "author", "type": "text", "required": true },
        { "name": "body", "type": "text", "required": true }
