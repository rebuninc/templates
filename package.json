{
  "name": "rebun-templates",
  "private": true,
  "workspaces": [
    "apps/*/*"
  ],
  "scripts": {
    "lint": "bun lint",
    "fmt": "bun fmt",
    "typecheck": "bun --filter '*' typecheck",
    "dev:blog": "bun --filter blog-tanstack-start dev",
    "dev:waitlist": "bun --filter waitlist-tanstack-start dev",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "husky": "9.1.7"
  }
}
